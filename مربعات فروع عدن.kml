	<Placemark id="057325E26642A094D686">
		<name>مربع (5)</name>
		<description><![CDATA[<div><span><span><span><span><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">المنصورة - من تقاطع شارع العين الى سوق عدن المركزي للخضار والفواكه ومروراً بسوق القات الصورة والحياء المجاورة لمستشفى الوالي.</font></font></span></span></span></span><br></div>]]></description>
		<LookAt>
			<longitude>44.98119038866129</longitude>
			<latitude>12.85404896556647</latitude>
			<altitude>6.677622518781181</altitude>
